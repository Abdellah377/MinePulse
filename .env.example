# Frontend
VITE_MAPTILER_API_KEY=
# Set true to use FastAPI + PostgreSQL instead of client mock world
VITE_USE_API=false
VITE_API_BASE=/api

# Database (also copy into backend/.env)
DB_HOST=localhost
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# AI investigations (optional; V1 provider implementation is OpenAI only).
# Leave AI_PROVIDER empty to keep investigation execution disabled.
AI_PROVIDER=
# Required when AI_PROVIDER=openai. Set this to a model available to your project.
AI_MODEL=
# Server-side secret used only by the backend. Never prefix it with VITE_.
OPENAI_API_KEY=
# Bounded diagnosis/evidence-expansion rounds. Valid range: 1-10.
AI_MAX_INVESTIGATION_ITERATIONS=3
# Per-call provider timeout. SDK retries stay disabled; MinePulse retries 429/timeout/5xx
# at most AI_PROVIDER_MAX_ATTEMPTS times (1-4).
AI_PROVIDER_TIMEOUT_SECONDS=45
AI_PROVIDER_MAX_ATTEMPTS=3
# Cumulative LLM-call budget across all rounds/conclusion/recommendation (10-150s).
# Synchronous frontend POST allows 180s; database work adds overhead.
AI_INVESTIGATION_LLM_BUDGET_SECONDS=150
# Process-wide cap on simultaneous LangGraph investigations.
AI_INVESTIGATION_MAX_CONCURRENT=2
# Developer-only LangGraph investigation debugger. Default false.
# When true, GET /api/ai/investigations/{id}/debug returns a structured trace.
# Hidden chain-of-thought is never stored. Restart the API after changing this.
AI_DEBUG_MODE=false
# Before running investigations: cd backend && python -m alembic upgrade head
# Read-only diagnosis: python scripts/smoke_ai.py --check-only

# Automatic deterministic monitoring (opt-in). Detectors persist alerts without LLM
# unless MONITORING_AUTO_INVESTIGATE=true.
MONITORING_ENABLED=false
MONITORING_AUTO_INVESTIGATE=false
MONITORING_INTERVAL_SECONDS=30
MONITORING_INVESTIGATION_COOLDOWN_MINUTES=15
MONITORING_UNEXPECTED_STOP_MINUTES=2
MONITORING_IDLE_THRESHOLD_MINUTES=5
MONITORING_COMMUNICATION_QUALITY_THRESHOLD=60
MONITORING_COMMUNICATION_CRITICAL_THRESHOLD=30
MONITORING_TELEMETRY_STALE_SECONDS=120
MONITORING_PRODUCTION_DEVIATION_PCT=20
MONITORING_CYCLE_DURATION_MULTIPLIER=1.5

# External weather context (Open-Meteo, no API key). Leave empty to disable fetches.
# Fair-use public API; V1 caches current weather ~10 minutes per site.
WEATHER_PROVIDER=
WEATHER_TIMEOUT_SECONDS=5
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_FORECAST_HOURS=3
