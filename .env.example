# MinePulse local development configuration
# Copy this file to .env and fill only the values needed for your setup.
# Never commit real credentials. Backend-only secrets must never use the VITE_ prefix.

# Frontend
# true: FastAPI/PostgreSQL data; false: client demo data.
VITE_USE_API=false
VITE_API_BASE=/api
VITE_MAPTILER_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minepulse_db
DB_USER=postgres
DB_PASSWORD=

# AI provider routing
# AI_PROVIDER_ORDER is optional, takes precedence over AI_PROVIDER, and supports
# technical failover (example: groq,gemini,openai). Missing fallbacks are skipped.
# Leave both settings empty to disable investigations.
AI_PROVIDER=
AI_PROVIDER_ORDER=
AI_MODEL=

# OpenAI
# OPENAI_MODEL overrides AI_MODEL for this provider when set.
OPENAI_MODEL=
OPENAI_API_KEY=

# Groq (OpenAI-compatible Chat Completions)
# Example model: openai/gpt-oss-120b
GROQ_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (OpenAI-compatible Chat Completions)
GEMINI_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Investigation limits and diagnostics
# Valid iteration range: 1-10. Default 2 = diagnose + at most one evidence expansion.
AI_MAX_INVESTIGATION_ITERATIONS=2
# Per-attempt HTTP timeout; SDK retries remain disabled.
# 15s covers measured healthy diagnose (~5s typical, 12.4s observed) without 45s hangs.
AI_PROVIDER_TIMEOUT_SECONDS=15
# MinePulse retries transient 429, timeout, network, and 5xx errors (valid: 1-4).
# When AI_PROVIDER_ORDER is set, each provider is tried once then failsover.
AI_PROVIDER_MAX_ATTEMPTS=2
# Cumulative LLM budget across diagnosis, conclusion, and recommendation (10-150s).
AI_INVESTIGATION_LLM_BUDGET_SECONDS=30
# Process-wide simultaneous investigation limit (valid: 1-8).
AI_INVESTIGATION_MAX_CONCURRENT=2
# Enables the developer-only structured trace endpoint; never stores chain-of-thought.
AI_DEBUG_MODE=false

# Automatic deterministic monitoring
# Detectors persist alerts without LLM calls unless auto-investigation is enabled.
MONITORING_ENABLED=false
MONITORING_AUTO_INVESTIGATE=false
MONITORING_INTERVAL_SECONDS=30
MONITORING_INVESTIGATION_COOLDOWN_MINUTES=15
MONITORING_UNEXPECTED_STOP_MINUTES=2
MONITORING_IDLE_THRESHOLD_MINUTES=5
MONITORING_COMMUNICATION_QUALITY_THRESHOLD=60
MONITORING_COMMUNICATION_CRITICAL_THRESHOLD=30
MONITORING_TELEMETRY_STALE_SECONDS=120
MONITORING_PRODUCTION_DEVIATION_PCT=20
MONITORING_CYCLE_DURATION_MULTIPLIER=1.5

# External weather context (Open-Meteo; no API key)
# Leave WEATHER_PROVIDER empty to disable fetches. Current weather is cached for
# approximately WEATHER_CACHE_TTL_SECONDS per site.
WEATHER_PROVIDER=
WEATHER_TIMEOUT_SECONDS=5
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_FORECAST_HOURS=3
